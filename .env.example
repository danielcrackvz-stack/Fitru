# Copia este archivo a .env. No pongas secretos reales en el repositorio.
# La app de demostración funciona sin ninguno de estos valores.

# Postgres/PostGIS o Supabase. Solo hace falta si aplicas las migraciones.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kufi
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Firma HMAC de los tokens de pago. No dejes un valor real en el repo.
# Si queda vacío, cada teléfono genera una clave y la guarda en el
# almacenamiento seguro. Para que dos teléfonos se reconozcan, los dos
# tienen que recibir el mismo valor:
# flutter run --dart-define=KUFI_TOKEN_SECRET=una-clave-larga-de-equipo
KUFI_TOKEN_SECRET=

# Teselas. Por defecto, en desarrollo, se usa tile.openstreetmap.org
# con atribución. No lo uses en producción.
TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© colaboradores de OpenStreetMap

# Ejemplos de producción (deja la llave fuera del repo):
# TILE_URL_TEMPLATE=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_LLAVE
# TILE_URL_TEMPLATE=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key=TU_LLAVE
# TILE_URL_TEMPLATE=https://tu-servidor/santa-cruz/{z}/{x}/{y}.png

# Push opcional. Sin este valor la app no intenta Firebase.
FCM_PROJECT_ID=
